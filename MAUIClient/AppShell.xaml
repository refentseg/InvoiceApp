<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MAUIClient.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MAUIClient"
    xmlns:views="clr-namespace:MAUIClient.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="MAUIClient">

    <!--Loading Page-->
    <ShellContent
        Title="Loading"
        ContentTemplate="{DataTemplate views:LoadingPage}"
        Route="loading"
        
        />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent Title="Invoices"
                   ContentTemplate="{DataTemplate views:InvoiceListPage}" />

    <ShellContent Title="InvoiceForm"
               ContentTemplate="{DataTemplate views:InvoiceFormPage}" />

</Shell>
