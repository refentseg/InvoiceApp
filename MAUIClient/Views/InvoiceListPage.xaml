<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:models="clr-namespace:MAUIClient.Models.InvoiceAggregate"
             x:Class="MAUIClient.Views.InvoiceListPage"
             Title="Invoices">
    <CollectionView ItemsSource="{Binding Invoices}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Invoice">
                <Border Stroke="LightGray"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8,8,8,8"
                        Padding="10"
                        Margin="5">
                    <StackLayout>
                        <Label Text="{Binding OrderDate, 
                                    StringFormat='Date: {0:MM/dd/yyyy}'}"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="Gray" />

                        <Label Text="{Binding Id}" 
                               FontSize="18" />

                        <Label Text="{Binding Total, 
                                        StringFormat='Amount: {0:C}'}"
                               FontSize="16"
                               TextColor="Green" />
                    </StackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    
</ContentPage>